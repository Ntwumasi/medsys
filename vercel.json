{
  "buildCommand": "cd server && npm install --include=dev && npm run build && cd ../client && npm install --include=dev && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-patient-texts",
      "schedule": "0 9 * * *"
    }
  ]
}
