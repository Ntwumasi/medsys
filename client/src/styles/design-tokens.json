  "font": {
    "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans', 'Noto Sans Arabic', 'Noto Sans Devanagari', sans-serif",
    "mono": "'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "weights": [
      400,
      500,
      700
    ],
    "hosting": "Inter + JetBrains Mono, the app's original fonts, loaded by the Google Fonts @import at the top of src/index.css (display=swap); system fallback."
  },
  "type": {
    "display": {
      "size": 32,
      "line": 40,
      "weight": 700,
      "tracking": "-0.01em"
    },
    "title": {
      "size": 22,
      "line": 30,
      "weight": 700
    },
    "heading": {
      "size": 17,
      "line": 24,
      "weight": 700
    },
    "body": {
      "size": 16,
      "line": 24,
      "weight": 400
    },
    "small": {
      "size": 14,
      "line": 20,
      "weight": 500
    },
    "caption": {
      "size": 13,
      "line": 18,
      "weight": 500,
      "note": "Minimum size; never below 13px"
    },
    "data": {
      "size": 15,
      "line": 22,
      "weight": 500,
      "family": "mono",
      "numerals": "tabular-nums"
    }
  },
  "space": [
    0,
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
  ],
  "radius": {
    "sm": 8,
    "control": 12,
    "card": 18,
    "sheet": 24,
    "pill": 9999
  },
  "size": {
    "touchMin": 44,
    "control": 48,
    "controlCompact": 40,
    "navItem": 48,
    "sidebar": 248,
    "patientBanner": 72
  },
  "shadow": {
    "none": "none",
    "card": "0 1px 2px rgba(28,25,23,0.04), 0 6px 20px rgba(28,25,23,0.06)",
    "overlay": "0 24px 60px rgba(28,25,23,0.18)",
    "cardDark": "0 1px 2px rgba(0,0,0,0.30)",
    "overlayDark": "0 24px 60px rgba(0,0,0,0.55)"
  },
  "motion": {
    "fast": "150ms",
    "base": "220ms",
    "slow": "280ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "exitEasing": "cubic-bezier(0.4, 0, 1, 1)",
    "reducedMotion": "Opacity fades only; no movement or scale"
  },
  "breakpoints": {
    "phone": 0,
    "tablet": 768,
    "desktop": 1024,
    "wide": 1440
  }
}
