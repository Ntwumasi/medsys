{
  "$description": "MedSys design system — direction C · Care (hyperlegible, warm, touch-first). Source of truth for client/src/styles/tokens.css and the `ds` namespace in tailwind.config.cjs. Contrast ratios are WCAG 2.x, measured on the surface each pair is used on. See docs/design-system.md.",
  "version": "1.0.0",
  "color": {
    "light": {
      "canvas": {
        "value": "#F6F4F1",
        "use": "App background"
      },
      "surface": {
        "value": "#FFFFFF",
        "use": "Cards, panels, inputs"
      },
      "subtle": {
        "value": "#F3EFEA",
        "use": "Table header, wells, skeletons"
      },
      "border": {
        "value": "#E5DED4",
        "use": "Hairline dividers (decorative, 1.33:1)"
      },
      "borderControl": {
        "value": "#8C857C",
        "use": "Input / select / checkbox outlines (3.65:1)"
      },
      "text": {
        "value": "#1C1917",
        "use": "Primary text (17.5:1)"
      },
      "textSecondary": {
        "value": "#57534E",
        "use": "Secondary text (7.6:1)"
      },
      "textMuted": {
        "value": "#6B6560",
        "use": "Labels, metadata (5.7:1)"
      },
      "accent": {
        "value": "#0F766E",
